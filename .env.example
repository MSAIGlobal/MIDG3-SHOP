# ─── MIDG3 environment ───────────────────────────────────────────────────────
# Copy to `.env.local` for local dev, and add the same keys in Netlify:
#   Site settings → Environment variables.
#
# Find these in your Supabase project → Project Settings → API.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The email address that owns the shop (the admin who can upload listings).
# Any account signing up with this email becomes the shop owner automatically.
# Server-only (NOT NEXT_PUBLIC) so it stays out of the public browser bundle.
OWNER_EMAIL=auntie@example.com

# Fixed-credential owner login (works without Supabase). Checked server-side;
# a successful sign-in sets a signed, httpOnly cookie. Keep these secret — set
# them in the host's env vars, never in the repo.
ADMIN_EMAIL=auntie@example.com
ADMIN_PASSWORD=choose-a-strong-password
# Random string used to sign the admin session cookie.
ADMIN_SESSION_SECRET=generate-a-long-random-string

# Optional: where "Message to buy" enquiries are sent, and the WhatsApp number
# (international format, digits only) used for the quick-buy button.
NEXT_PUBLIC_CONTACT_EMAIL=auntie@example.com
NEXT_PUBLIC_WHATSAPP=447000000000

# Midge's Revolut username for the "Buy now" button (revolut.me/<username>).
# A bare username, an @handle, or the full revolut.me link all work.
NEXT_PUBLIC_REVOLUT_USERNAME=midge
